generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         String    @default("PRATICIEN")
  specialty    String    @default("")
  phone        String    @default("")
  address      String    @default("")
  bio          String    @default("")
  avatarUrl    String    @default("")
  maxClientsPerDay Int   @default(6)
  bufferMinutes    Int   @default(15)

  // Abonnement Stripe
  stripeCustomerId   String?   @unique
  stripeSubscriptionId String?
  stripePriceId      String?
  stripeCurrentPeriodEnd DateTime?
  trialEndsAt        DateTime?

  // Google Calendar
  googleAccessToken    String?
  googleRefreshToken   String?
  googleCalendarId     String?   @default("primary")
  googleTokenExpiry    DateTime?

  // Sécurité credentials (PR 2B)
  // Forcer changement de mot de passe à la première connexion (compte créé par coach).
  mustChangePassword     Boolean   @default(false)
  // Date du dernier changement de mot de passe (audit, expiration future).
  passwordChangedAt      DateTime?
  // Date de génération d'un mot de passe temporaire (pour expiration éventuelle).
  passwordTempCreatedAt  DateTime?
  // Version de session — incrémentée à chaque changement de mot de passe ;
  // permet d'invalider les sessions JWT existantes via comparaison serveur.
  sessionVersion         Int       @default(0)
  // Audit : derniere connexion réussie.
  lastLoginAt            DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clients      Client[]
  seances      Seance[]
  factures     Facture[]

  // Compte adherent (role = ADHERENT)
  clientProfile Client? @relation("AdherentAccount")
}

// Fiche client enrichie pour le suivi therapeutique
model Client {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @default("")
  phone         String    @default("")
  dateOfBirth   String    @default("")
  gender        String    @default("")
  address       String    @default("")
  profession    String    @default("")
  referredBy    String    @default("")
  status        String    @default("ACTIF")

  // Anamnese / Bilan initial
  motifConsultation  String  @default("")
  antecedentsMedicaux String @default("")
  antecedentsFamiliaux String @default("")
  traitementEnCours  String  @default("")
  allergies          String  @default("")
  habitudesVie       String  @default("")
  qualiteSommeil     String  @default("")
  niveauStress       String  @default("")
  alimentation       String  @default("")
  activitePhysique   String  @default("")

  // Suivi therapeutique
  objectifs          String  @default("")
  contreIndications  String  @default("")
  consentement       Boolean @default(false)

  // Onboarding & Body Check
  onboardingDone     Boolean @default(false)
  taille             Float?    // en cm
  poids              Float?    // en kg
  poidsObjectif      Float?    // en kg
  imc                Float?
  niveauSport        String  @default("")
  frequenceSport     String  @default("")
  objectifPrincipal  String  @default("")
  regimeAlimentaire  String  @default("")
  hydratation        String  @default("")
  complements        String  @default("")
  problemesSante     String  @default("")
  scoreGlobal        Int?
  motivation         Int?      // 1-10
  tourTaille         Float?    // en cm
  dateObjectif       DateTime?
  aimeManger         String  @default("")
  mangeDeTout        Boolean @default(true)
  grignotage         String  @default("")
  repasParJour       String  @default("")
  petitDejeuner      String  @default("")
  dernierBilanDate   DateTime?

  // Notes internes
  notesPrivees       String  @default("")

  // Compte adherent lie
  adherentUser    User?   @relation("AdherentAccount", fields: [adherentUserId], references: [id])
  adherentUserId  String? @unique

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  praticien     User      @relation(fields: [praticienId], references: [id], onDelete: Cascade)
  praticienId   String
  seances       Seance[]
  factures      Facture[]
  notes         NoteEvolution[]
  programmes    ClientProgramme[]
  progressions  Progression[]
  mesures       Mesure[]
  workoutLogs   WorkoutLog[]
}

// Suivi des mensurations dans le temps
model Mesure {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  poids       Float?
  tourTaille  Float?
  imc         Float?
  note        String   @default("")

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
}

// Table de liaison Client <-> Programme — enrichie en PR 2C
model ClientProgramme {
  id          String   @id @default(cuid())
  assignedAt  DateTime @default(now())

  // PR 2C — suivi de l'assignation
  startDate            DateTime?
  endDate              DateTime?
  status               String    @default("ACTIF")  // ACTIF | PAUSE | TERMINE | ARCHIVE
  currentWeek          Int       @default(1)
  currentSession       Int       @default(1)
  coachNotes           String    @default("")
  personalAdaptations  Json?
  updatedAt            DateTime  @default(now()) @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String

  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  programmeId String

  workoutLogs WorkoutLog[]

  @@unique([clientId, programmeId])
  @@index([clientId])
  @@index([status])
  @@index([startDate])
}

// Notes d'evolution - timeline du suivi
model NoteEvolution {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  title       String
  content     String
  category    String   @default("observation")
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
}

model Seance {
  id            String    @id @default(cuid())
  date          DateTime
  duration      Int       @default(60)
  type          String    @default("Consultation")
  status        String    @default("PLANIFIEE")
  notesBefore   String    @default("")
  notesAfter    String    @default("")
  notesPrivate  String    @default("")
  price         Float     @default(0)
  paid          Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  praticien     User      @relation(fields: [praticienId], references: [id], onDelete: Cascade)
  praticienId   String
}

model Facture {
  id            String    @id @default(cuid())
  number        String    @unique
  date          DateTime  @default(now())
  dueDate       DateTime?
  amount        Float
  status        String    @default("EN_ATTENTE")
  description   String    @default("")
  paymentMethod String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  praticien     User      @relation(fields: [praticienId], references: [id], onDelete: Cascade)
  praticienId   String
}

// ============ CITY COACHING ============

model Programme {
  id          String     @id @default(cuid())
  nom         String
  description String     @default("")
  objectif    String     @default("remise_forme")
  niveau      String     @default("debutant")
  duree       Int        @default(4)
  image       String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  exercices    Exercice[]              // legacy v1, conservé en compat. Sera déprécié post PR 4.
  clients      ClientProgramme[]
  progressions Progression[]
  weeks        ProgrammeWeek[]         // PR 2C — structure premium
}

model Exercice {
  id           String      @id @default(cuid())
  nom          String
  description  String      @default("")
  series       Int         @default(3)
  repetitions  String      @default("10-12")
  repos        Int         @default(60)
  conseils     String      @default("")
  ordre        Int         @default(0)
  createdAt    DateTime    @default(now())

  programme    Programme   @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  programmeId  String

  equipement   Equipement? @relation(fields: [equipementId], references: [id])
  equipementId String?

  progressions Progression[]
}

// Suivi de progression des adherents
model Progression {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  completed   Boolean  @default(true)

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String

  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  programmeId String

  exercice    Exercice  @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
  exerciceId  String

  @@unique([clientId, exerciceId, date])
}

model Equipement {
  id          String     @id @default(cuid())
  nom         String
  description String     @default("")
  muscles     String     @default("")
  categorie   String     @default("musculation")
  conseils    String     @default("")
  image       String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  exercices   Exercice[]
}

// ====================================================================
// PR 2C — Modèle sportif premium (additif, sans drop)
// ====================================================================

/// Bibliothèque d'exercices réutilisable, indépendante des programmes.
/// Soft delete via isActive=false ou archivedAt set (jamais de DELETE dur
/// si l'exercice est référencé par au moins un SessionExercise).
model ExerciseLibrary {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  description            String    @default("")
  /// Groupe musculaire principal : PECTORAUX | DOS | EPAULES | BICEPS |
  /// TRICEPS | JAMBES | FESSIERS | ABDOS | MOLLETS | AVANT_BRAS |
  /// FULL_BODY | CARDIO
  primaryMuscleGroup     String
  /// Groupes musculaires secondaires (mêmes valeurs).
  secondaryMuscleGroups  String[]  @default([])
  /// Identifiants équipement (string libre pour rester souple :
  /// "barbell", "dumbbell", "cable", "machine_leg_press", etc.).
  equipment              String[]  @default([])
  /// DEBUTANT | INTERMEDIAIRE | AVANCE
  level                  String    @default("DEBUTANT")
  /// Tags d'objectif compatibles : PRISE_MASSE | PERTE_POIDS |
  /// REMISE_FORME | ENDURANCE | FORCE | SOUPLESSE.
  goalTags               String[]  @default([])
  instructions           String    @default("")
  commonMistakes         String[]  @default([])
  contraindications      String[]  @default([])
  mediaUrl               String?
  /// Soft-delete : false = archivé.
  isActive               Boolean   @default(true)
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sessionExercises       SessionExercise[]

  @@index([primaryMuscleGroup])
  @@index([level])
  @@index([isActive])
  @@index([createdAt])
}

/// Une semaine d'un programme.
model ProgrammeWeek {
  id           String   @id @default(cuid())
  programmeId  String
  weekNumber   Int
  title        String   @default("")
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  programme    Programme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  sessions     ProgrammeSession[]

  @@unique([programmeId, weekNumber])
  @@index([programmeId])
}

/// Une séance dans une semaine.
model ProgrammeSession {
  id                       String   @id @default(cuid())
  programmeWeekId          String
  sessionNumber            Int
  title                    String   @default("")
  /// Focus de la séance : "Push", "Pull", "Jambes", "Cardio HIIT"…
  focus                    String   @default("")
  estimatedDurationMinutes Int      @default(45)
  notes                    String   @default("")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  programmeWeek    ProgrammeWeek    @relation(fields: [programmeWeekId], references: [id], onDelete: Cascade)
  sessionExercises SessionExercise[]
  workoutLogs      WorkoutLog[]

  @@unique([programmeWeekId, sessionNumber])
  @@index([programmeWeekId])
}

/// Prescription d'un exercice de la bibliothèque dans une séance.
/// Sépare strictement la bibliothèque (`ExerciseLibrary`) de la prescription.
model SessionExercise {
  id                  String   @id @default(cuid())
  programmeSessionId  String
  exerciseLibraryId   String
  /// Ordre d'exécution dans la séance (1, 2, 3, …).
  order               Int
  sets                Int      @default(3)
  repsMin             Int      @default(8)
  repsMax             Int      @default(12)
  /// Charge cible textuelle libre : "12kg", "60% 1RM", "à ressenti".
  targetLoad          String   @default("")
  restSeconds         Int      @default(60)
  /// Tempo "3-1-1-0" (concentrique-pause-excentrique-pause).
  tempo               String   @default("")
  /// RPE cible 1-10.
  targetRpe           Int?
  coachNotes          String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  programmeSession  ProgrammeSession @relation(fields: [programmeSessionId], references: [id], onDelete: Cascade)
  exerciseLibrary   ExerciseLibrary  @relation(fields: [exerciseLibraryId], references: [id])
  workoutSetLogs    WorkoutSetLog[]

  @@index([programmeSessionId])
  @@index([exerciseLibraryId])
}

/// Historique d'exécution d'une séance par un adhérent (=performance réelle).
/// Distinct de la prescription (qui est dans ProgrammeSession + SessionExercise).
model WorkoutLog {
  id                   String    @id @default(cuid())
  clientId             String
  /// Lien vers l'assignation (programme suivi). Nullable pour permettre les
  /// séances libres (hors programme).
  clientProgrammeId    String?
  /// Séance prescrite référencée. Nullable si séance libre.
  programmeSessionId   String?
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  /// PLANNED | IN_PROGRESS | COMPLETED | SKIPPED | CANCELLED
  status               String    @default("IN_PROGRESS")
  /// Difficulté ressentie globale 1-10 (RPE séance).
  perceivedDifficulty  Int?
  clientNotes          String    @default("")
  coachReviewNotes     String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client            Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientProgramme   ClientProgramme?  @relation(fields: [clientProgrammeId], references: [id], onDelete: SetNull)
  programmeSession  ProgrammeSession? @relation(fields: [programmeSessionId], references: [id], onDelete: SetNull)
  workoutSetLogs    WorkoutSetLog[]

  @@index([clientId])
  @@index([clientProgrammeId])
  @@index([programmeSessionId])
  @@index([status])
  @@index([startedAt])
}

/// Une série effectivement réalisée pendant un WorkoutLog.
model WorkoutSetLog {
  id                String   @id @default(cuid())
  workoutLogId      String
  /// Référence à l'exercice prescrit. Nullable pour les séries libres
  /// (échauffement, exercice ad-hoc).
  sessionExerciseId String?
  setNumber         Int
  /// Cible texte (ex: "8-12"). Conservé pour audit/comparaison.
  targetReps        String   @default("")
  /// Reps réellement effectuées.
  actualReps        Int?
  /// Cible texte (ex: "12kg", "à ressenti").
  targetLoad        String   @default("")
  /// Charge réelle en kg (Float pour 12.5kg etc.).
  actualLoad        Float?
  /// RPE 1-10 ressenti sur cette série.
  rpe               Int?
  completed         Boolean  @default(false)
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workoutLog       WorkoutLog       @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  sessionExercise  SessionExercise? @relation(fields: [sessionExerciseId], references: [id], onDelete: SetNull)

  @@index([workoutLogId])
  @@index([sessionExerciseId])
}
